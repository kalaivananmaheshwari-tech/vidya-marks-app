# Configure through your host's protected environment settings. Do not commit .env or real credentials.
# REQUIRED: durable PostgreSQL. Every supplied URL is honored; no silent production PGlite fallback.
DATABASE_URL=postgresql://USER:REPLACE_WITH_SECRET@HOST:5432/DATABASE
# REQUIRED in production: exact HTTPS application origin(s), comma-separated. No wildcard/reflection.
APP_ORIGINS=https://marks.example.edu.in
# Never auto-migrate production or seed production. Back up, run db:migrate and db:check explicitly.
AUTO_MIGRATE=0
DEMO_MODE=0
# Set to 1 only when a trusted edge OVERWRITES x-forwarded-for (never passes client-supplied values).
# Without a trusted proxy, account limits still apply and source limits use a conservative global bucket.
TRUST_PROXY=0
# Optional verified recovery; leave unset until a real delivery integration is configured and tested.
# RECOVERY_SECRET=AT_LEAST_32_RANDOM_CHARACTERS_FROM_YOUR_SECRET_MANAGER
# SMS_WEBHOOK_URL=https://your-authorized-sms-adapter.example/send
# SMS_API_KEY=CONFIGURE_IN_SECRET_MANAGER_ONLY
# Explicit embedded PostgreSQL compatibility for development only (not production):
# VIDYA_DEV_DATABASE=pglite
# PGLITE_DATA_DIR=./.pgdata
# Prefer scripts/db:local for isolated native PostgreSQL verification; its private .cache data is ephemeral.
