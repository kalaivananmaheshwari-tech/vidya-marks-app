# Copy to .env and fill in before deploying.
#
# The ONLY required variable. Point it at any PostgreSQL 14+ database.
# The app creates its own tables on first boot — no migration command needed.
#
# Local development (an embedded PGlite database is used automatically when this
# variable is missing or points at localhost):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Neon / Supabase / managed Postgres usually need SSL, e.g.
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
#
# ⚠️ Vercel / Railway / Render are serverless or ephemeral: the embedded fallback
#    cannot persist data there, so DATABASE_URL is MANDATORY in production.
#    Use the "pooled" Neon connection string (host contains "-pooler").
#    Check GET /api/health → "persistent": true to confirm.
#
# Docker Compose (matches docker-compose.yml):
# DATABASE_URL=postgresql://vidya:change_this_password@db:5432/vidya_analytics
# DB_PASSWORD=change_this_password
